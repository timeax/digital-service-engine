{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ServiceProps",
  "definitions": {
    "ServiceProps": {
      "type": "object",
      "properties": {
        "order_for_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        },
        "includes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "excludes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "option_effects_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/OptionEffectForButton"
            }
          }
        },
        "value_effects_for_triggers": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/definitions/FieldValueEffect"
            }
          }
        },
        "schema_version": {
          "type": "string"
        },
        "fallbacks": {
          "$ref": "#/definitions/ServiceFallback"
        },
        "name": {
          "type": "string"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServicePropsNotice"
          }
        }
      },
      "required": [
        "filters",
        "fields"
      ]
    },
    "Tag": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bind_id": {
          "type": "string"
        },
        "service_id": {
          "$ref": "#/definitions/ServiceIdRef"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Which flags are set for this tag. If a flag is not set, it's inherited from the nearest ancestor with a value set."
        },
        "constraints_origin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Which ancestor defined the *effective* value for each flag (nearest source)."
        },
        "constraints_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {
                "type": "boolean"
              },
              "to": {
                "type": "boolean"
              },
              "origin": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "origin"
            ]
          },
          "description": "Present only when a child explicitly set a different value but was overridden by an ancestor during normalisation."
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "ServiceIdRef": {
      "$ref": "#/definitions/IdType"
    },
    "IdType": {
      "type": [
        "string",
        "number"
      ]
    },
    "Field": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "button": {
              "type": "boolean",
              "const": false
            },
            "service_id": {
              "not": {}
            },
            "id": {
              "type": "string"
            },
            "type": {
              "$ref": "#/definitions/FieldType"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "component": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "multi": {
                  "type": "boolean"
                },
                "utility": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "flat",
                        "per_quantity",
                        "per_value",
                        "percent"
                      ]
                    },
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length"
                      ]
                    },
                    "percentBase": {
                      "type": "string",
                      "enum": [
                        "service_total",
                        "base_service",
                        "all"
                      ]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rate",
                    "mode"
                  ]
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length",
                        "eval"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "multiply": {
                      "type": "number"
                    },
                    "clamp": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    },
                    "fallback": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "valueBy"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "defaultValue": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Scalar"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Scalar"
                  }
                }
              ],
              "description": "Initial form value for fresh order flows."
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {},
              "description": "Host-defined prop names → runtime default values (untyped base)"
            }
          },
          "required": [
            "id",
            "label",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            },
            "button": {
              "type": "boolean",
              "const": true
            },
            "service_id": {
              "$ref": "#/definitions/ServiceIdRef"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "$ref": "#/definitions/FieldType"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "component": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "multi": {
                  "type": "boolean"
                },
                "utility": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "flat",
                        "per_quantity",
                        "per_value",
                        "percent"
                      ]
                    },
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length"
                      ]
                    },
                    "percentBase": {
                      "type": "string",
                      "enum": [
                        "service_total",
                        "base_service",
                        "all"
                      ]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rate",
                    "mode"
                  ]
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length",
                        "eval"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "multiply": {
                      "type": "number"
                    },
                    "clamp": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    },
                    "fallback": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "valueBy"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "defaultValue": {
              "anyOf": [
                {
                  "$ref": "#/definitions/Scalar"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Scalar"
                  }
                }
              ],
              "description": "Initial form value for fresh order flows."
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {},
              "description": "Host-defined prop names → runtime default values (untyped base)"
            }
          },
          "required": [
            "button",
            "id",
            "label",
            "type"
          ]
        }
      ]
    },
    "FieldType": {
      "type": "string"
    },
    "FieldOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "service_id": {
          "$ref": "#/definitions/ServiceIdRef"
        },
        "pricing_role": {
          "$ref": "#/definitions/PricingRole"
        },
        "meta": {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            },
            "utility": {
              "type": "object",
              "properties": {
                "rate": {
                  "type": "number"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "flat",
                    "per_quantity",
                    "per_value",
                    "percent"
                  ]
                },
                "valueBy": {
                  "type": "string",
                  "enum": [
                    "value",
                    "length"
                  ]
                },
                "percentBase": {
                  "type": "string",
                  "enum": [
                    "service_total",
                    "base_service",
                    "all"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "rate",
                "mode"
              ]
            }
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/FieldOption"
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "PricingRole": {
      "type": "string",
      "enum": [
        "base",
        "utility"
      ]
    },
    "FieldValidationRule": {
      "type": "object",
      "properties": {
        "valueBy": {
          "$ref": "#/definitions/FieldValidationValueBy"
        },
        "op": {
          "$ref": "#/definitions/FieldValidationOp"
        },
        "value": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {}
        },
        "pattern": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "op"
      ]
    },
    "FieldValidationValueBy": {
      "type": "string",
      "enum": [
        "value",
        "length",
        "eval"
      ]
    },
    "FieldValidationOp": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "gt",
        "gte",
        "lt",
        "lte",
        "between",
        "in",
        "nin",
        "truthy",
        "falsy",
        "match"
      ]
    },
    "Scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "$ref": "#/definitions/ButtonValue"
        },
        {
          "type": "null"
        }
      ]
    },
    "ButtonValue": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "service_id": {
          "$ref": "#/definitions/ServiceIdRef"
        },
        "pricing_role": {
          "type": "string",
          "enum": [
            "base",
            "utility"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            },
            "utility": {
              "type": "object",
              "properties": {
                "rate": {
                  "type": "number"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "flat",
                    "per_quantity",
                    "per_value",
                    "percent"
                  ]
                },
                "valueBy": {
                  "type": "string",
                  "enum": [
                    "value",
                    "length"
                  ]
                },
                "percentBase": {
                  "type": "string",
                  "enum": [
                    "service_total",
                    "base_service",
                    "all"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "rate",
                "mode"
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "value"
      ]
    },
    "OptionEffectForButton": {
      "type": "object",
      "properties": {
        "forceVisible": {
          "type": "boolean",
          "description": "If true, selecting this button/option may force the target field visible. If false/missing, the option filter only applies when the target field is already visible."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "If present, only these option ids remain visible."
        },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Removed after include is applied."
        }
      }
    },
    "FieldValueEffect": {
      "type": "object",
      "properties": {
        "value": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scalar"
            },
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/Scalar"
              }
            }
          ],
          "description": "Value assigned to the target field while the trigger is active."
        },
        "mode": {
          "type": "string",
          "enum": [
            "always",
            "if_empty"
          ],
          "description": "Default: \"always\"."
        },
        "clearOnDeactivate": {
          "type": "boolean",
          "description": "Default: false."
        }
      },
      "required": [
        "value"
      ]
    },
    "ServiceFallback": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceIdRef"
            }
          },
          "description": "Node-scoped fallbacks: prefer these when that node’s primary service fails"
        },
        "global": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceIdRef"
            }
          },
          "description": "Primary→fallback list used when no node-scoped entry is present"
        }
      }
    },
    "ServicePropsNotice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/NoticeType"
        },
        "kind": {
          "$ref": "#/definitions/NoticeKind"
        },
        "severity": {
          "$ref": "#/definitions/NoticeSeverity"
        },
        "target": {
          "$ref": "#/definitions/NoticeTarget"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "marked_at": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "severity",
        "target",
        "title"
      ]
    },
    "NoticeType": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "NoticeKind": {
      "type": "string",
      "enum": [
        "label",
        "warning",
        "deprecation",
        "compat",
        "migration",
        "policy"
      ],
      "description": "“label” is lightweight + UI-friendly (best, sale, hot, etc). Others remain semantic / governance oriented."
    },
    "NoticeSeverity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "NoticeTarget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "node"
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "tag",
                "field",
                "option"
              ]
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "node_kind",
            "node_id"
          ]
        }
      ]
    }
  }
}