{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EditorSnapshot",
  "definitions": {
    "EditorSnapshot": {
      "type": "object",
      "properties": {
        "props": {
          "$ref": "#/definitions/ServiceProps"
        },
        "layout": {
          "$ref": "#/definitions/LayoutState"
        },
        "comments": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CommentNode"
          }
        },
        "catalog": {
          "$ref": "#/definitions/ServiceCatalogState"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "props"
      ]
    },
    "ServiceProps": {
      "type": "object",
      "properties": {
        "order_for_tags": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "orderKinds": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "filters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Tag"
          }
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Field"
          }
        },
        "includes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "excludes_for_buttons": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "schema_version": {
          "type": "string"
        },
        "fallbacks": {
          "$ref": "#/definitions/ServiceFallback"
        },
        "name": {
          "type": "string"
        },
        "notices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServicePropsNotice"
          }
        }
      },
      "required": [
        "filters",
        "fields"
      ]
    },
    "Tag": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "bind_id": {
          "type": "string"
        },
        "service_id": {
          "$ref": "#/definitions/ServiceIdRef"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            }
          }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Which flags are set for this tag. If a flag is not set, it's inherited from the nearest ancestor with a value set."
        },
        "constraints_origin": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Which ancestor defined the *effective* value for each flag (nearest source)."
        },
        "constraints_overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "from": {
                "type": "boolean"
              },
              "to": {
                "type": "boolean"
              },
              "origin": {
                "type": "string"
              }
            },
            "required": [
              "from",
              "to",
              "origin"
            ]
          },
          "description": "Present only when a child explicitly set a different value but was overridden by an ancestor during normalisation."
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "ServiceIdRef": {
      "$ref": "#/definitions/IdType"
    },
    "IdType": {
      "type": [
        "string",
        "number"
      ]
    },
    "Field": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "button": {
              "type": "boolean",
              "const": false
            },
            "service_id": {
              "not": {}
            },
            "id": {
              "type": "string"
            },
            "type": {
              "$ref": "#/definitions/FieldType"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "component": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "multi": {
                  "type": "boolean"
                },
                "utility": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "flat",
                        "per_quantity",
                        "per_value",
                        "percent"
                      ]
                    },
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length"
                      ]
                    },
                    "percentBase": {
                      "type": "string",
                      "enum": [
                        "service_total",
                        "base_service",
                        "all"
                      ]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rate",
                    "mode"
                  ]
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length",
                        "eval"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "multiply": {
                      "type": "number"
                    },
                    "clamp": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    },
                    "fallback": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "valueBy"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {},
              "description": "Host-defined prop names → runtime default values (untyped base)"
            }
          },
          "required": [
            "id",
            "label",
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            },
            "button": {
              "type": "boolean",
              "const": true
            },
            "service_id": {
              "$ref": "#/definitions/ServiceIdRef"
            },
            "id": {
              "type": "string"
            },
            "type": {
              "$ref": "#/definitions/FieldType"
            },
            "bind_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "name": {
              "type": "string"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldOption"
              }
            },
            "description": {
              "type": "string"
            },
            "component": {
              "type": "string"
            },
            "pricing_role": {
              "$ref": "#/definitions/PricingRole"
            },
            "validation": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/FieldValidationRule"
              }
            },
            "meta": {
              "type": "object",
              "properties": {
                "multi": {
                  "type": "boolean"
                },
                "utility": {
                  "type": "object",
                  "properties": {
                    "rate": {
                      "type": "number"
                    },
                    "mode": {
                      "type": "string",
                      "enum": [
                        "flat",
                        "per_quantity",
                        "per_value",
                        "percent"
                      ]
                    },
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length"
                      ]
                    },
                    "percentBase": {
                      "type": "string",
                      "enum": [
                        "service_total",
                        "base_service",
                        "all"
                      ]
                    },
                    "label": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "rate",
                    "mode"
                  ]
                },
                "quantity": {
                  "type": "object",
                  "properties": {
                    "valueBy": {
                      "type": "string",
                      "enum": [
                        "value",
                        "length",
                        "eval"
                      ]
                    },
                    "code": {
                      "type": "string"
                    },
                    "multiply": {
                      "type": "number"
                    },
                    "clamp": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      }
                    },
                    "fallback": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "valueBy"
                  ]
                }
              }
            },
            "label": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": {},
              "description": "Host-defined prop names → runtime default values (untyped base)"
            }
          },
          "required": [
            "button",
            "id",
            "label",
            "type"
          ]
        }
      ]
    },
    "FieldType": {
      "type": "string"
    },
    "FieldOption": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "service_id": {
          "$ref": "#/definitions/ServiceIdRef"
        },
        "pricing_role": {
          "$ref": "#/definitions/PricingRole"
        },
        "meta": {
          "type": "object",
          "properties": {
            "quantityDefault": {
              "type": "number"
            },
            "utility": {
              "type": "object",
              "properties": {
                "rate": {
                  "type": "number"
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "flat",
                    "per_quantity",
                    "per_value",
                    "percent"
                  ]
                },
                "valueBy": {
                  "type": "string",
                  "enum": [
                    "value",
                    "length"
                  ]
                },
                "percentBase": {
                  "type": "string",
                  "enum": [
                    "service_total",
                    "base_service",
                    "all"
                  ]
                },
                "label": {
                  "type": "string"
                }
              },
              "required": [
                "rate",
                "mode"
              ]
            }
          }
        }
      },
      "required": [
        "id",
        "label"
      ]
    },
    "PricingRole": {
      "type": "string",
      "enum": [
        "base",
        "utility"
      ]
    },
    "FieldValidationRule": {
      "type": "object",
      "properties": {
        "valueBy": {
          "$ref": "#/definitions/FieldValidationValueBy"
        },
        "op": {
          "$ref": "#/definitions/FieldValidationOp"
        },
        "value": {},
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "values": {
          "type": "array",
          "items": {}
        },
        "pattern": {
          "type": "string"
        },
        "flags": {
          "type": "string"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "op"
      ]
    },
    "FieldValidationValueBy": {
      "type": "string",
      "enum": [
        "value",
        "length",
        "eval"
      ]
    },
    "FieldValidationOp": {
      "type": "string",
      "enum": [
        "eq",
        "neq",
        "gt",
        "gte",
        "lt",
        "lte",
        "between",
        "in",
        "nin",
        "truthy",
        "falsy",
        "match"
      ]
    },
    "ServiceFallback": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceIdRef"
            }
          },
          "description": "Node-scoped fallbacks: prefer these when that node’s primary service fails"
        },
        "global": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/ServiceIdRef"
            }
          },
          "description": "Primary→fallback list used when no node-scoped entry is present"
        }
      }
    },
    "ServicePropsNotice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/definitions/NoticeType"
        },
        "kind": {
          "$ref": "#/definitions/NoticeKind"
        },
        "severity": {
          "$ref": "#/definitions/NoticeSeverity"
        },
        "target": {
          "$ref": "#/definitions/NoticeTarget"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "marked_at": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "type",
        "kind",
        "severity",
        "target",
        "title"
      ]
    },
    "NoticeType": {
      "type": "string",
      "enum": [
        "public",
        "private"
      ]
    },
    "NoticeKind": {
      "type": "string",
      "enum": [
        "label",
        "warning",
        "deprecation",
        "compat",
        "migration",
        "policy"
      ],
      "description": "“label” is lightweight + UI-friendly (best, sale, hot, etc). Others remain semantic / governance oriented."
    },
    "NoticeSeverity": {
      "type": "string",
      "enum": [
        "info",
        "warning",
        "error"
      ]
    },
    "NoticeTarget": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "global"
            }
          },
          "required": [
            "scope"
          ]
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "node"
            },
            "node_kind": {
              "type": "string",
              "enum": [
                "tag",
                "field",
                "option"
              ]
            },
            "node_id": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "node_kind",
            "node_id"
          ]
        }
      ]
    },
    "LayoutState": {
      "type": "object",
      "properties": {
        "canvas": {
          "$ref": "#/definitions/CanvasState"
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EdgeRoute"
          }
        }
      },
      "required": [
        "canvas"
      ]
    },
    "CanvasState": {
      "type": "object",
      "properties": {
        "graph": {
          "$ref": "#/definitions/GraphSnapshot"
        },
        "positions": {
          "$ref": "#/definitions/NodePositions"
        },
        "selection": {
          "type": "object",
          "properties": {
            "size": {
              "type": "number"
            }
          },
          "required": [
            "size"
          ]
        },
        "highlighted": {
          "type": "object",
          "properties": {
            "size": {
              "type": "number"
            }
          },
          "required": [
            "size"
          ]
        },
        "hoverId": {
          "type": "string"
        },
        "viewport": {
          "$ref": "#/definitions/Viewport"
        },
        "draftWire": {
          "$ref": "#/definitions/DraftWire"
        },
        "version": {
          "type": "number"
        }
      },
      "required": [
        "graph",
        "positions",
        "selection",
        "highlighted",
        "viewport",
        "version"
      ]
    },
    "GraphSnapshot": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphEdge"
          }
        }
      },
      "required": [
        "nodes",
        "edges"
      ]
    },
    "GraphNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/NodeKind"
        },
        "bind_type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "bound",
            "utility",
            null
          ]
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ]
    },
    "NodeKind": {
      "type": "string",
      "enum": [
        "tag",
        "field",
        "comment",
        "option"
      ]
    },
    "GraphEdge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/EdgeKind"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "from",
        "to",
        "kind"
      ]
    },
    "EdgeKind": {
      "type": "string",
      "enum": [
        "child",
        "bind",
        "include",
        "exclude",
        "error",
        "anchor"
      ]
    },
    "NodePositions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/NodePos"
      }
    },
    "NodePos": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ]
    },
    "Viewport": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number"
        }
      },
      "required": [
        "x",
        "y",
        "zoom"
      ]
    },
    "DraftWire": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/EdgeKind"
        }
      },
      "required": [
        "from",
        "kind"
      ]
    },
    "EdgeRoute": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ]
          }
        }
      },
      "required": [
        "id",
        "points"
      ]
    },
    "CommentNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "resolved"
          ]
        },
        "anchor": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tag",
                "field",
                "option"
              ]
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id"
          ]
        },
        "replies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "created_at": {
                "type": "string"
              },
              "author": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text",
              "created_at"
            ]
          }
        },
        "xy": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          },
          "required": [
            "x",
            "y"
          ]
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "id",
        "text",
        "status"
      ]
    },
    "ServiceCatalogState": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogNode"
          }
        },
        "activeNodeId": {
          "$ref": "#/definitions/CatalogId"
        },
        "expandedIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogId"
          }
        },
        "pinnedNodeIds": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/CatalogId"
          }
        },
        "selectedServiceId": {
          "$ref": "#/definitions/CatalogServiceId"
        },
        "viewMode": {
          "$ref": "#/definitions/CatalogViewMode"
        },
        "meta": {
          "type": "object",
          "additionalProperties": {}
        }
      },
      "required": [
        "version",
        "nodes"
      ]
