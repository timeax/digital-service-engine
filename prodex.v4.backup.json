{
    "version": 4,
    "$schema": "https://raw.githubusercontent.com/emxhive/prodex/main/schema/prodex.schema.json",
    "output": {
        "dir": "prodex",
        "versioned": true,
        "format": "md"
    },
    "entry": [],
    "include": [],
    "exclude": [
        "node_modules/**",
        "vendor/**",
        "dist/**",
        "@shadcn/**",
        "**/components/ui/**"
    ],
    "resolve": {
        "aliases": {
            "@": "resources/js"
        },
        "maxDepth": 10,
        "maxFiles": 200
    },
    "profiles": {
        "schema": {
            "include": [
                "src/schema/**"
            ]
        },
        "core": {
            "include": [
                "src/core/**"
            ]
        },
        "react-adapters": {
            "include": [
                "src/react/adapters/**"
            ]
        },
        "react-canvas": {
            "include": [
                "src/react/canvas/**"
            ]
        },
        "react-hooks": {
            "include": [
                "src/react/hooks/**"
            ]
        },
        "react-inputs": {
            "include": [
                "src/react/inputs/**"
            ]
        },
        "react-fallback": {
            "include": [
                "src/react/fallback-editor/**"
            ]
        },
        "react-workspace": {
            "include": [
                "src/react/workspace/**"
            ]
        },
        "react": {
            "include": [
                "src/react/index.ts"
            ]
        },
        "utils": {
            "include": [
                "src/utils/**"
            ]
        },
        "json-schema": {
            "include": [
                "schema/**"
            ]
        }
    }
}
